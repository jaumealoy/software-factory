{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native software factory — MVP 1 (request to task graph)",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @software-factory/api db:generate",
    "db:migrate": "pnpm --filter @software-factory/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.41.0"
  }
}
